# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# MVP auth model: the publishable (anon) key + RLS policies guard the table.
# Writes are constrained by a CHECK policy; email is not publicly readable.
# See supabase/migrations/0002_media_kits_rls.sql.
SUPABASE_PUBLISHABLE_KEY=replace-me

# Optional hardening: if set, the server prefers the service-role key over the
# publishable key (bypasses RLS — server-only, never expose to the browser).
# SUPABASE_SERVICE_ROLE_KEY=replace-me

# ---------------------------------------------------------------------------
# AI copy generation (Vercel AI Gateway)
# ---------------------------------------------------------------------------
# Omit locally on Vercel to use OIDC; set for local dev or non-Vercel hosts.
# If the model call fails, the app falls back to deterministic copy.
AI_GATEWAY_API_KEY=replace-me

# Optional model override (default: anthropic/claude-haiku-4.5)
# MEDIA_KIT_MODEL=anthropic/claude-haiku-4.5
